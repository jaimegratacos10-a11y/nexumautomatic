    {
      "id": "Due bookings",
      "name": "Due bookings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const now=Date.now(); return $input.all().filter(({json:r})=>{\n const start=Date.parse(r.start), delta=start-now;\n const key=r.booking_key+'|'+new Date(Number.isFinite(start)?start:0).toISOString();\n return r.status==='confirmed' && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(r.email||'') && delta>0 && delta<=86400000 && delta>=84600000 && !(r.reminder_key===key && ['sending','sent','uncertain'].includes(r.reminder_state));\n}).map(({json:r})=>({json:{...r,reminder_key:r.booking_key+'|'+new Date(r.start).toISOString()}}));"
      }
    },
    {
      "id": "Get current event",
      "name": "Get current event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "get",
        "calendar": {
          "__rl": true,
          "value": "REPLACE_CALENDAR_ID",
          "mode": "id"
        },
        "eventId": "={{ $json.event_id }}",
        "options": {}
      }
    },
    {
      "id": "Revalidate",
      "name": "Revalidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const rows=$('Due bookings').all(); return $input.all().flatMap(({json:e},i)=>{\n const r=rows[i]?.json; if(!r || e.status!=='confirmed' || Date.parse(e.start?.dateTime)!==Date.parse(r.start)) return [];\n const guest=(e.attendees||[]).find(a=>a.email===r.email && a.responseStatus!=='declined');\n if(!guest || Date.parse(r.start)<=Date.now()) return [];\n return [{json:{...r,reminder_state:'sending'},pairedItem:{item:i}}];\n});"
      }
    },
