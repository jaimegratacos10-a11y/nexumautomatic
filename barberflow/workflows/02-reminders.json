      "parameters": {
        "jsCode": "return $input.all().map((item,i)=>{const r=$('Revalidate').itemMatching(i).json; const date=new Intl.DateTimeFormat('es-ES',{timeZone:'Europe/Madrid',dateStyle:'full',timeStyle:'short'}).format(new Date(r.start)); return {json:{...r,subject:'Recordatorio de tu cita — BARBERFLOW DEMO',message:'Hola '+(r.name||'')+',\\nTe recordamos tu cita: '+r.service+' el '+date+'.\\nPara cambiar o cancelar, utiliza el correo de confirmación de Google Calendar.\\nBARBERFLOW DEMO',reminder_state:'sent'},pairedItem:{item:i}};});"
