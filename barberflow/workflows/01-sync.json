{
  "name": "BARBERFLOW 01-sync",
  "nodes": [
    {
      "id": "Schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "Calendar events",
      "name": "Calendar events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "REPLACE_CALENDAR_ID",
          "mode": "id"
        },
        "returnAll": true,
        "options": {
          "showDeleted": true
        }
      }
    },
    {
      "id": "Normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const out=[];\nfor(const {json:e} of $input.all()) {\n if(!e.id || e.recurringEventId || e.recurrence) continue;\n const guest=(e.attendees||[]).find(a=>!a.self&&!a.organizer&&a.responseStatus!=='declined');\n if(e.status!=='cancelled' && (!guest || !e.start?.dateTime)) continue;\n const calendar_id='REPLACE_CALENDAR_ID';\n out.push({json:{booking_key:calendar_id+'|'+e.id,calendar_id,event_id:e.id,service:e.summary||'',start:e.start?.dateTime||'',end:e.end?.dateTime||'',name:guest?.displayName||'',email:guest?.email||'',status:e.status||'confirmed',updated:e.updated||''}});\n} return out;"
      }
    },
    {
      "id": "Upsert bookings",
      "name": "Upsert bookings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
